<openerp>
    <data>

        <record model="ir.ui.view" id="sped_tabelas_informacoes_relativas_exterior_form">
            <field name="name">sped_tabelas_informacoes_relativas_exterior_form</field>
            <field name="model">sped.informacoes.relativas.exterior</field>
            <field name="priority">1</field>
            <field name="arch" type="xml">
                <form string="Informacoes Relativas Rendimento Exterior"
                edit="false" delete="false" create="false">
                    <sheet>
                        <group>
                            <group name="geral" colspan="4" col="2">
                                <field name="codigo"/>
                                <field name="descricao" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="sped_tabelas_informacoes_relativas_exterior_tree">
            <field name="name">sped_tabelas_informacoes_relativas_exterior_tree</field>
            <field name="model">sped.informacoes.relativas.exterior</field>
            <field name="priority">1</field>
            <field name="arch" type="xml">
                <tree string="Informacoes Relativas Rendimento Exterior" edit="false" create="false" delete="false">
                    <field name="codigo"/>
                    <field name="descricao" />
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="sped_tabelas_informacoes_relativas_exterior_search">
            <field name="name">sped_tabelas.sped.informacoes_relativas_exterior_search</field>
            <field name="model">sped.informacoes.relativas.exterior</field>
            <field name="priority">1</field>
            <field name="arch" type="xml">
                <search string="Informacoes Relativas Rendimento Exterior">
                    <field name="codigo" />
                    <field name="descricao" />
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="sped_tabelas_informacoes_relativas_exterior_action">
            <field name="name">sped_tabelas.sped.informacoes_relativas_exterior_</field>
            <field name="res_model">sped.informacoes.relativas.exterior</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record model="ir.actions.act_window.view" id="sped_tabelas_informacoes_relativas_exterior_tree_action">
            <field eval="1" name="sequence"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="sped_tabelas_informacoes_relativas_exterior_tree"/>
            <field name="act_window_id" ref="sped_tabelas_informacoes_relativas_exterior_action"/>
        </record>

        <record model="ir.actions.act_window.view" id="sped_tabelas_informacoes_relativas_exterior_form_action">
            <field eval="2" name="sequence"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="sped_tabelas_informacoes_relativas_exterior_form"/>
            <field name="act_window_id" ref="sped_tabelas_informacoes_relativas_exterior_action"/>
        </record>

        <menuitem
            action="sped_tabelas_informacoes_relativas_exterior_action"
            id="menu_sped_informacoes_relativas_exterior"
            name="10-Informacoes Relativas Rendimento Exterior"
            parent="sped_tabelas.menu_sped_tabelas_efdreinf"
            sequence="10"
        />

    </data>
</openerp>

<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>

        <record id="sped_efdreinf_r4099_form" model="ir.ui.view">
            <field name="name">EFD Reinf R-4099 Abertura</field>
            <field name="model">sped.efdreinf.abertura.eventos.4000</field>
            <field name="arch" type="xml">
                <form string="EFD Reinf - Registro R-4099 - Abertura" edit="false" delete="false" create="false" duplicate="false">
                    <header>
                        <button name="criar_registro" colspan="4" type="object"
                                string="Ativar/Atualizar EFD Reinf" class="oe_highlight"
                                attrs="{'invisible': [('situacao', 'in', ['1', '3', '9'])]}" />
                        <field name="situacao" widget="statusbar" select="1" nolabel="1" readonly="1" />
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="nome" readonly="1"/>
                            </h1>
                        </div>
                        <group colspan="4" col="4">
                            <group colspan="4" col="2">
                                <field name="company_id" readonly="1"/>
                                <field name="reinf_competencia_id" readonly="1"/>
                                <field name="periodo_id" readonly="1"/>
                            </group>
                            <group colspan="4" col="2">
                                <field name="sped_r4099_registro" readonly="1"/>
                            </group>
                        </group>
                        <separator string="Abertura Anteriores"/>
                        <field name="sped_r4099_registro_ids" readonly="1"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="sped_efdreinf_r4099_tree">
            <field name="name">R-4099 (Abertura Eventos 4000)</field>
            <field name="model">sped.efdreinf.abertura.eventos.4000</field>
            <field name="arch" type="xml">
                <tree string="R-4099 (Abertura Eventos 4000)" duplicate="false" edit="false" delete="false" create="false">
                    <field name="company_id"/>
                    <field name="situacao"/>
                    <field name="periodo_id"/>
                    <field name="sped_r4099_registro"/>
                </tree>
            </field>
        </record>

    </data>
</openerp>
